export PATH="${HOME}/bin:/usr/local/bin:${PATH}"
if command -v go &>/dev/null; then
  export PATH="$PATH:$(go env GOPATH)/bin"
fi

export MACHINE_NAME="kelpie"

# Uncomment the following line to enable command auto-correction.
ENABLE_CORRECTION="false"
DISABLE_CORRECTION="true"

fpath=(${HOME}/completion_zsh $fpath)

autoload -U compinit; compinit

alias pdflatex='docker run -it --rm -v "${PWD}:/root/shared/folder:z" --name pdflatex pdflatex'
alias bw="flatpak run --command=bw com.bitwarden.desktop"
alias k="kubectl"
alias kk="kubie"

function kex() {
	sed -i '/current-context/d' ~/.kube/config
}


function zle-line-init() {
    # Home keys
    bindkey '\e[1~' beginning-of-line
    bindkey '\e[H'  beginning-of-line
    bindkey '\eOH'  beginning-of-line

    # End keys
    bindkey '\e[4~' end-of-line
    bindkey '\e[F'  end-of-line
    bindkey '\eOF'  end-of-line
    
    # Standard navigation safety nets
    bindkey '\e[3~' delete-char
    bindkey '\e[2~' overwrite-mode
}
zle -N zle-line-init

# Force Ctrl+R to open reverse history search
bindkey '^R' history-incremental-search-backward


export EDITOR='/usr/bin/vim'
if [[ -e /usr/bin/nvim ]]; then
    export EDITOR='/usr/bin/nvim'
    alias vim="nvim"
fi

# kuadrant qe ocp-tool
export OCP_CLUSTER_MANAGEMENT_DIR="${HOME}/src/rh/ocp/cluster-management/"
export OCP_TOOL_DIR="${HOME}/src/rh/ocp/ocp-tool"
